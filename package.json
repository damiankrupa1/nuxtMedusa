{
  "name": "nuxt-starter-medusa",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "author": "Damian Krupa",
  "description": "Modern fashion ecommerce storefront built with Nuxt 4, Medusa and Tailwind CSS.",
  "keywords": [
    "nuxt",
    "medusa",
    "e-commerce",
    "storefront",
    "medusa-storefront"
  ],
  "lint-staged": {
    "*.{js,ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,scss,md}": [
      "prettier --write"
    ]
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "test": "vitest run --typecheck",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@medusajs/js-sdk": "2.22.7",
    "@nuxt/image": "^2.2.1",
    "@nuxt/ui": "3.3.7",
    "@nuxtjs/i18n": "^10.6.0",
    "@nuxtjs/sitemap": "^9.1.0",
    "@sentry/nuxt": "^11.14.0",
    "@stripe/stripe-js": "^6.0.0",
    "jose": "6.2.17",
    "lodash": "^4.18.1",
    "nuxt": "^4.6.4",
    "vue": "^3.5.45",
    "zod": "^4.6.7"
  },
  "packageManager": "pnpm@11.5.0",
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@iconify-json/flag": "^1.2.15",
    "@iconify-json/lucide": "^1.2.156",
    "@iconify-json/simple-icons": "^1.2.103",
    "@medusajs/types": "2.22.7",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.4.0",
    "@playwright/test": "1.65.1",
    "@types/lodash": "^4.17.27",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/compiler-sfc": "^3.5.45",
    "@vue/test-utils": "^2.6.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "h3": "1.15.11",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "typescript": "^5.8.2",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
