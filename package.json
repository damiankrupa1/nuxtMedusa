{
  "name": "nuxt-starter-medusa",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "author": "Damian Krupa",
  "description": "Modern fashion ecommerce storefront built with Nuxt 4, Medusa and Tailwind CSS.",
  "keywords": [
    "nuxt",
    "medusa",
    "e-commerce",
    "storefront",
    "medusa-storefront"
  ],
  "lint-staged": {
    "*.{js,ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,scss,md}": [
      "prettier --write"
    ]
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "test": "vitest run --typecheck"
  },
  "dependencies": {
    "@medusajs/js-sdk": "2.19.0",
    "@nuxt/image": "^2.2.0",
    "@nuxt/ui": "3.0.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@nuxtjs/medusa": "1.2.0",
    "@nuxtjs/sitemap": "^9.1.0",
    "@sentry/nuxt": "^11.10.0",
    "@stripe/stripe-js": "^6.0.0",
    "lodash": "^4.17.21",
    "nuxt": "^4.6.3",
    "vue": "^3.5.44",
    "zod": "^4.4.3"
  },
  "packageManager": "pnpm@11.5.0",
  "devDependencies": {
    "@nuxt/test-utils": "^4.3.4",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@iconify-json/flag": "^1.2.5",
    "@iconify-json/lucide": "^1.2.29",
    "@iconify-json/simple-icons": "^1.2.28",
    "@medusajs/types": "2.19.0",
    "@nuxt/eslint": "^1.17.0",
    "@types/lodash": "^4.17.16",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/compiler-sfc": "^3.5.44",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.5",
    "typescript": "^5.8.2",
    "vitest": "5.0.5",
    "wrangler": "^3.109.2"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
