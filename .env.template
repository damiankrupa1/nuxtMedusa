# Medusa API URL (default: http://localhost:9000)
NUXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Medusa Publishable API Key (optional)
NUXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# Stripe publishable key for payment processing
NUXT_PUBLIC_STRIPE_KEY=pk_test_your_stripe_publishable_key

# InPost Geowidget token for the parcel locker map in the delivery step
NUXT_PUBLIC_INPOST_GEOWIDGET_TOKEN=

# Public origin of the storefront (e.g. https://shop.example.com), used for
# canonical/hreflang links, sitemap.xml and robots.txt. Falls back to the
# request origin when unset.
NUXT_PUBLIC_SITE_URL=

# Payload CMS base URL (e.g. https://cms.example.com). The storefront's
# editorial content (navigation, footer, home page sections and their images)
# comes only from here: without it those sections are not rendered.
NUXT_PUBLIC_PAYLOAD_URL=

# Extra hostnames (comma-separated) that serve Payload's images, e.g. the
# bucket host in Payload's S3_FILE_URL. Needed only when image URLs are not on
# the Payload host; lets NuxtImg optimize them.
NUXT_PUBLIC_PAYLOAD_IMAGE_HOSTS=

# Sentry error monitoring (same Sentry organization as the Medusa backend and
# admin). Leave the DSN empty to turn Sentry off: errors then only go to the
# console. The DSN is public by design (it ships to the browser).
NUXT_PUBLIC_SENTRY_DSN=
# Server-side DSN if it differs from the one above (defaults to it)
SENTRY_DSN=
# Defaults to Vercel's VERCEL_ENV (production|preview|development), else NODE_ENV
NUXT_PUBLIC_SENTRY_ENVIRONMENT=
# Defaults to the commit SHA Vercel builds (VERCEL_GIT_COMMIT_SHA)
NUXT_PUBLIC_SENTRY_RELEASE=
# Share of requests to trace, 0-1 (e.g. 0.05). Empty or 0 keeps tracing off.
NUXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=

# Source map upload, build time only. Keep these in Vercel/CI secrets, never as
# NUXT_PUBLIC_*. Without SENTRY_AUTH_TOKEN no source maps are generated or
# uploaded; with it the maps go to Sentry and are deleted from the build output.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
