# Medusa API URL (default: http://localhost:9000)
NUXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Medusa Publishable API Key (optional)
NUXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# Stripe publishable key for payment processing
NUXT_PUBLIC_STRIPE_KEY=pk_test_your_stripe_publishable_key

# InPost Geowidget token for the parcel locker map in the delivery step
NUXT_PUBLIC_INPOST_GEOWIDGET_TOKEN=

# Public origin of the storefront (e.g. https://shop.example.com), used for
# canonical/hreflang links, sitemap.xml and robots.txt. Falls back to the
# request origin when unset.
NUXT_PUBLIC_SITE_URL=
